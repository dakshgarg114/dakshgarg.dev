---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const clients = ["Self-custody wallets", "Crypto exchanges", "Browser wallets"];

const projects = [
  {
    no: "01",
    name: "MPC Wallet Extension",
    kind: "Browser wallet",
    blurb: "MPC key management for a browser wallet, paired with a mobile app: device pairing, signing, encrypted backup, and recovery.",
    code: ["pair(device)", "keygen(2, 2)", "sign(tx, share)", "// key never assembled"],
  },
  {
    no: "02",
    name: "Enclave Signing Nodes",
    kind: "Infrastructure",
    blurb: "Multi-party signing nodes running inside hardware enclaves, provisioned as infrastructure as code.",
    code: ["$ tofu apply", "> enclave: attested", "> node-0: ready", "> node-1: ready"],
  },
  {
    no: "03",
    name: "Voice Coding Stack",
    kind: "Personal / AI tooling",
    blurb: "Talk to Claude Code and hear it talk back: local speech to text, an LLM cleanup pass, and on-device text to speech.",
    code: ["$ handy --listen", "> stt: 0.3s", "> cleanup: ok", "> speak: queued"],
  },
];

const experience = [
  {
    years: "Apr 2023 to now",
    role: "Forward Deployed Engineer",
    org: "Silence Laboratories",
    note: "Take MPC and threshold signing from protocol to production inside customer systems, and lead the product side of client launches.",
    points: [
      "Led a user key migration onto MPC threshold signing for a large crypto exchange.",
      "Shipped MPC integrations for self-custody wallets, including signing and recovery flows.",
      "Built the Flutter SDK suite from scratch: ECDSA (DKLs23), EdDSA, and Taproot.",
      "Built a load-testing and tracing harness for concurrent signing sessions.",
    ],
  },
  {
    years: "Mar 2021 to Mar 2023",
    role: "Founding Engineer",
    org: "SiteForm",
    note: "Construction tech for jobsite safety and operations.",
    points: [
      "Built the delivery management system and the jobsite dashboard running on site monitors.",
      "Rewrote data fetching with optimistic updates and GraphQL caching across web and mobile.",
    ],
  },
  {
    years: "2018 to 2022",
    role: "B.Tech, Electronics and Communication",
    org: "IIT (BHU) Varanasi",
    note: "Codeforces Master, peak rating 2118.",
    points: [],
  },
];

const toolkit = [
  { group: "Languages", items: "Rust, Dart, TypeScript, Python, C++" },
  { group: "Cryptography", items: "MPC, threshold signatures, DKLs23, ECDSA, EdDSA, Schnorr, Taproot, BIP32" },
  { group: "Infrastructure", items: "AWS Nitro Enclaves, KMS, Terraform, OpenTofu, Docker, GitHub Actions" },
  { group: "AI engineering", items: "LLMs, AI agents, MCP, multi-agent orchestration" },
  { group: "Apps", items: "Flutter, React Native, React, GraphQL, Node.js, FFI" },
];

const stats = [
  { value: "5", label: "Years in production" },
  { value: "4", label: "Client launches" },
  { value: "2118", label: "Codeforces peak" },
];

const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Base title="Daksh Garg">
  <header class="topbar wrap">
    <p class="label">Earning the flow state back<br />in the AI era</p>
    <a class="monogram" href="/" aria-label="Home"><span>D</span><i></i><span>G</span></a>
    <p class="label right">Portfolio<br />2026</p>
  </header>

  <section class="hero wrap">
    <div class="hero-text">
      <h1 class="name">Daksh<br />Garg</h1>
      <p class="role label">Forward Deployed Engineer · MPC and wallet infrastructure</p>
      <p class="intro">I take cryptographic infrastructure from protocol to production inside customer systems. Now I am rebuilding how I work so AI speeds me up without breaking my flow state, the deep focus where hours disappear.</p>
      <span class="rule wide"></span>
    </div>
    <div class="hero-photo">
      <div class="disc"></div>
      <img src="/portrait.webp" alt="Portrait of Daksh Garg" width="957" height="1600" />
    </div>
  </section>

  <section class="clients">
    <div class="wrap clients-row">
      <span class="label">Delivered for</span>
      <ul>
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap projects">
      <div class="projects-head">
        <h2 class="section-title">Selected<br />work</h2>
        <p>From MPC protocols to production deployments and the AI tooling I use every day.</p>
        <a class="link-arrow" href="https://github.com/dakshgarg114">View on GitHub <span>→</span></a>
      </div>
      {
        projects.map((p) => (
          <article class="project">
            <header>
              <span class="no">{p.no}</span>
              <div>
                <h3 class="label">{p.name}</h3>
                <p class="kind">{p.kind}</p>
              </div>
            </header>
            <span class="rule" />
            <div class="screen">
              <div class="dots"><i /><i /><i /></div>
              {p.code.map((line) => <code>{line}</code>)}
            </div>
            <p class="blurb">{p.blurb}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap split">
    <div>
      <h2 class="section-title">Experience</h2>
      <span class="rule"></span>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li>
              <span class="label years">{e.years}</span>
              <div>
                <h3>{e.role}, <span>{e.org}</span></h3>
                <p>{e.note}</p>
                {e.points.length > 0 && (
                  <ul class="points">
                    {e.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div>
      <h2 class="section-title">Toolkit</h2>
      <span class="rule"></span>
      <dl class="toolkit">
        {
          toolkit.map((t) => (
            <div>
              <dt class="label">{t.group}</dt>
              <dd>{t.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap impact">
    <div class="stats">
      {
        stats.map((s) => (
          <div>
            <strong>{s.value}</strong>
            <span class="label">{s.label}</span>
          </div>
        ))
      }
    </div>
    <blockquote>
      <span class="mark">“</span>
      <p>Flow first. Code follows, <em>my brother.</em></p>
    </blockquote>
  </section>

  <section class="wrap writing">
    <div class="writing-head">
      <h2 class="section-title">Writing</h2>
      <span class="rule"></span>
    </div>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="label date">{fmt(post.data.date)}</span>
              <span class="title">{post.data.title}</span>
              <span class="arrow">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="link-arrow" href="/blog/">All posts <span>→</span></a>
  </section>

  <footer class="band connect">
    <div class="wrap connect-grid">
      <div>
        <h2 class="section-title">Let's<br />connect</h2>
        <span class="rule"></span>
        <p class="avail">Open to forward deployed engineering roles at AI and crypto companies.</p>
      </div>
      <ul class="contacts">
        <li><span class="label">Email</span><a href="mailto:dgdakshgarg114@gmail.com">dgdakshgarg114@gmail.com</a></li>
        <li><span class="label">LinkedIn</span><a href="https://linkedin.com/in/daksh-garg-6382271a0">linkedin.com/in/daksh-garg</a></li>
        <li><span class="label">X</span><a href="https://x.com/dgdakshgarg114">@dgdakshgarg114</a></li>
        <li><span class="label">GitHub</span><a href="https://github.com/dakshgarg114">github.com/dakshgarg114</a></li>
        <li><span class="label">Location</span><span>Remote, India</span></li>
      </ul>
      <a class="cta" href="mailto:dgdakshgarg114@gmail.com">
        <span class="label">Let's build<br />something together</span>
        <span class="cta-arrow">→</span>
      </a>
    </div>
  </footer>
</Base>

<style>
  .topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 16px;
  }

  .topbar .right {
    text-align: right;
  }

  .monogram {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 44px;
    height: 44px;
    font-family: var(--body);
    font-weight: 500;
    font-size: 15px;
  }

  .monogram span:last-of-type {
    align-self: end;
    justify-self: end;
  }

  .monogram i {
    position: absolute;
    left: 50%;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--accent);
    transform: rotate(35deg);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: end;
    gap: 24px;
    padding-top: 48px;
  }

  .hero-text {
    padding-bottom: 72px;
  }

  .name {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(88px, 15vw, 196px);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .role {
    color: var(--accent);
    font-size: 13px;
    margin-top: 28px;
  }

  .intro {
    max-width: 440px;
    margin-top: 28px;
    color: var(--ink-soft);
  }

  .rule.wide {
    width: 64px;
    margin-top: 40px;
  }

  .hero-photo {
    position: relative;
    align-self: end;
  }

  .disc {
    position: absolute;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    right: 2%;
    top: 12%;
  }

  .hero-photo img {
    position: relative;
    width: 100%;
    height: auto;
  }

  .clients {
    border-top: 1px solid var(--line);
  }

  .clients-row {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .clients-row .label {
    color: var(--accent);
    white-space: nowrap;
  }

  .clients-row ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 48px;
  }

  .clients-row li {
    font-family: var(--display);
    font-size: clamp(22px, 2.6vw, 32px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .points {
    margin-top: 10px;
    padding-left: 18px;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .points li {
    margin-top: 4px;
  }

  .points li::marker {
    color: var(--accent);
  }

  .band {
    background: var(--bg-alt);
  }

  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 32px;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .projects-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .projects-head p {
    color: var(--ink-soft);
    max-width: 220px;
  }

  .projects-head .link-arrow {
    margin-top: auto;
  }

  .project header {
    display: flex;
    gap: 14px;
    align-items: baseline;
  }

  .no {
    font-family: var(--mono);
    font-weight: 600;
  }

  .project h3 {
    font-weight: 600;
    color: var(--ink);
  }

  .kind {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .screen {
    margin-top: 20px;
    aspect-ratio: 4 / 5;
    background: #111;
    border-radius: 6px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
  }

  .screen code {
    font-family: var(--mono);
    font-size: 12px;
    color: #d8d6cf;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero > *,
  .projects > *,
  .split > *,
  .impact > *,
  .connect-grid > *,
  .stats > * {
    min-width: 0;
  }

  .screen code:first-of-type {
    color: var(--accent);
  }

  .dots {
    display: flex;
    gap: 6px;
    margin-bottom: 10px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3a3a38;
  }

  .blurb {
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    padding-top: 88px;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line);
  }

  .timeline {
    list-style: none;
    margin-top: 32px;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .years {
    color: var(--ink-soft);
    padding-top: 4px;
  }

  .timeline h3 {
    font-size: 17px;
    font-weight: 600;
  }

  .timeline h3 span {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .timeline p {
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  .toolkit {
    margin-top: 32px;
  }

  .toolkit div {
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .toolkit dt {
    color: var(--accent);
  }

  .toolkit dd {
    margin-top: 6px;
  }

  .impact {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .stats div {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .stats div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .stats strong {
    display: block;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1;
  }

  .stats .label {
    display: block;
    margin-top: 12px;
    color: var(--ink-soft);
  }

  blockquote {
    border: 1px solid var(--line);
    padding: 28px 32px;
    display: flex;
    gap: 16px;
  }

  .mark {
    font-family: var(--display);
    font-size: 64px;
    line-height: 0.8;
    color: var(--accent);
  }

  blockquote p {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
  }

  blockquote em {
    font-style: normal;
    color: var(--accent);
  }

  .writing {
    padding-top: 24px;
    padding-bottom: 88px;
  }

  .writing ul {
    list-style: none;
    margin: 32px 0 28px;
  }

  .writing li a {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    transition: padding 0.2s ease;
  }

  .writing li:last-child a {
    border-bottom: 1px solid var(--line);
  }

  .writing li a:hover {
    padding-left: 12px;
  }

  .writing li a:hover .arrow,
  .writing li a:hover .title {
    color: var(--accent);
  }

  .date {
    color: var(--ink-soft);
  }

  .title {
    font-size: 19px;
    font-weight: 500;
  }

  .connect-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr auto;
    gap: 48px;
    padding-top: 72px;
    padding-bottom: 72px;
    align-items: start;
  }

  .avail {
    margin-top: 24px;
    color: var(--ink-soft);
    max-width: 300px;
  }

  .contacts {
    list-style: none;
    display: grid;
    gap: 18px;
    padding-left: 48px;
    border-left: 1px solid var(--line);
  }

  .contacts li {
    display: grid;
    gap: 2px;
  }

  .contacts .label {
    font-size: 10px;
    color: var(--ink-soft);
  }

  .contacts a:hover {
    color: var(--accent);
  }

  .cta {
    border: 1px solid var(--ink);
    padding: 24px;
    width: 200px;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cta:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .cta-arrow {
    align-self: end;
    font-size: 28px;
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .projects {
      grid-template-columns: 1fr 1fr;
    }

    .projects-head {
      grid-column: 1 / -1;
    }

    .projects-head p {
      max-width: none;
    }

    .split,
    .impact,
    .connect-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .contacts {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 720px) {
    .topbar {
      grid-template-columns: 1fr auto;
    }

    .topbar .right {
      display: none;
    }

    .hero {
      grid-template-columns: 1fr;
      padding-top: 24px;
    }

    .hero-text {
      padding-bottom: 8px;
    }

    .hero-photo {
      max-width: 420px;
      margin: 0 auto;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .clients-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .clients-row ul {
      gap: 8px 24px;
    }

    .screen {
      aspect-ratio: 16 / 10;
    }

    .timeline > li,
    .writing li a {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .writing .arrow {
      display: none;
    }

    .stats {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .stats div {
      padding-left: 12px;
    }

    .stats strong {
      font-size: 40px;
    }

    .stats .label {
      font-size: 9px;
      letter-spacing: 0.14em;
    }

    .role {
      letter-spacing: 0.14em;
    }

    .cta {
      width: 100%;
      aspect-ratio: auto;
      gap: 24px;
    }
  }
</style>
