---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Base title={`${post.data.title} | Daksh Garg`} description={post.data.description}>
  <main class="wrap post">
    <a class="link-arrow" href="/blog/">← All posts</a>
    <p class="label date">{date}</p>
    <h1>{post.data.title}</h1>
    <span class="rule"></span>
    <article>
      <Content />
    </article>
  </main>
</Base>

<style>
  .post {
    max-width: 720px;
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .date {
    color: var(--ink-soft);
    margin-top: 40px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.15;
    font-weight: 600;
    margin-top: 12px;
  }

  article {
    margin-top: 40px;
    font-size: 18px;
    line-height: 1.75;
  }

  article :global(p),
  article :global(ul),
  article :global(ol),
  article :global(pre),
  article :global(blockquote) {
    margin-bottom: 1.3em;
  }

  article :global(h2) {
    font-size: 26px;
    margin: 1.8em 0 0.6em;
  }

  article :global(ul),
  article :global(ol) {
    padding-left: 1.3em;
  }

  article :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  article :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--bg-alt);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  article :global(pre) {
    background: #111;
    color: #e8e6df;
    padding: 20px;
    border-radius: 6px;
    overflow-x: auto;
  }

  article :global(pre code) {
    background: none;
    padding: 0;
  }

  article :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 20px;
    color: var(--ink-soft);
  }
</style>
